# Identidad git de ESTE container. Editar antes del primer build.
#
# Por qué existe: Dev Containers copia el ~/.gitconfig del host adentro del
# container. En la notebook laboral eso significa nacer como dib@adhoc.inc.
# assert-identity.sh pisa esos valores con los de acá en cada arranque, y falla
# si el email sigue siendo el placeholder.
#
# El email queda en cada commit público, así que commitearlo acá no expone nada
# nuevo. Si preferís no publicarlo, usá el noreply de GitHub:
#   <id>+diegobollini@users.noreply.github.com
#   (el <id> lo ves en https://api.github.com/users/diegobollini)

GIT_USER_NAME="Diego Bollini"
GIT_USER_EMAIL="CAMBIAME@example.com"
